    "arm64"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "prepare": "node scripts/postinstall.js"
  },
  "dependencies": {
    "tar": "^7.4.0",
    "unzipper": "^0.12.0"
  },
  "keywords": [
    "tui",
    "terminal",
    "security",
    "pentesting",
    "llm",
    "rust"
  ],
