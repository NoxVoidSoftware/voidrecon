{
  "name": "voidrecon",
  "type": "module",
  "version": "0.1.1",
  "description": "Production-grade interactive TUI terminal for security auditing, CLI workflows, and LLM-assisted terminal operations. Wrapper for native Rust binary.",
  "main": "index.js",
  "bin": {
    "voidrecon": "index.js"
  },
  "files": [
    "index.js",
    "bin/voidrecon",
    "scripts/postinstall.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
